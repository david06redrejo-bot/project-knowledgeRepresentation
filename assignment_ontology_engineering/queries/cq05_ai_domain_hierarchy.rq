PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX crg: <http://www.semanticweb.org/uab/catalan-research-groups#>

# CQ05: Hierarchical path from Knowledge Representation to Engineering
SELECT ?subDomain ?parentDomain
WHERE {
  ?subDomain rdfs:subClassOf ?parentDomain .
  ?parentDomain rdfs:subClassOf* crg:EngineeringAndTechnology .
}
