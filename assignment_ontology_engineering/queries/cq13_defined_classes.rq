PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX crg: <http://www.semanticweb.org/uab/catalan-research-groups#>

# CQ13 & CQ14: Identify defined classes and their owl:equivalentClass axioms
SELECT ?definedClass ?equivalentExpression
WHERE {
  ?definedClass owl:equivalentClass ?equivalentExpression .
}
