<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/uab/catalan-research-groups"
         xmlns="http://www.semanticweb.org/uab/catalan-research-groups#">

<owl:Ontology rdf:about="http://www.semanticweb.org/uab/catalan-research-groups"/>

<owl:ObjectProperty rdf:about="#belongsToInstitution">
  <rdfs:domain rdf:resource="#ResearchGroup"/>
  <rdfs:range rdf:resource="#ResearchOrganization"/>
  <owl:inverseOf rdf:resource="#hostsResearchGroup"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hostsResearchGroup">
  <rdfs:domain rdf:resource="#ResearchOrganization"/>
  <rdfs:range rdf:resource="#ResearchGroup"/>
  <owl:inverseOf rdf:resource="#belongsToInstitution"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPrincipalInvestigator">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ResearchGroup"/>
  <rdfs:range rdf:resource="#PrincipalInvestigator"/>
  <owl:inverseOf rdf:resource="#isPrincipalInvestigatorOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isPrincipalInvestigatorOf">
  <rdfs:domain rdf:resource="#PrincipalInvestigator"/>
  <rdfs:range rdf:resource="#ResearchGroup"/>
  <owl:inverseOf rdf:resource="#hasPrincipalInvestigator"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMember">
  <rdfs:domain rdf:resource="#ResearchGroup"/>
  <rdfs:range rdf:resource="#Researcher"/>
  <owl:inverseOf rdf:resource="#isMemberOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isMemberOf">
  <rdfs:domain rdf:resource="#Researcher"/>
  <rdfs:range rdf:resource="#ResearchGroup"/>
  <owl:inverseOf rdf:resource="#hasMember"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#investigatesDomain">
  <rdfs:domain rdf:resource="#ResearchOrganization"/>
  <rdfs:range rdf:resource="#ResearchDomain"/>
  <owl:inverseOf rdf:resource="#isDomainOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isDomainOf">
  <rdfs:domain rdf:resource="#ResearchDomain"/>
  <rdfs:range rdf:resource="#ResearchOrganization"/>
  <owl:inverseOf rdf:resource="#investigatesDomain"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#holdsGrant">
  <rdfs:domain rdf:resource="#ResearchGroup"/>
  <rdfs:range rdf:resource="#GrantAccreditation"/>
  <owl:inverseOf rdf:resource="#isAwardedTo"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAwardedTo">
  <rdfs:domain rdf:resource="#GrantAccreditation"/>
  <rdfs:range rdf:resource="#ResearchGroup"/>
  <owl:inverseOf rdf:resource="#holdsGrant"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#collaboratesWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#ResearchOrganization"/>
  <rdfs:range rdf:resource="#ResearchOrganization"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#subDomainOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#ResearchDomain"/>
  <rdfs:range rdf:resource="#ResearchDomain"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasOfficialName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agent"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAcronym">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ResearchOrganization"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSGRCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ResearchGroup"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasInternalCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ResearchGroup"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasWebURL">
  <rdfs:domain rdf:resource="#ResearchOrganization"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasOrcid">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasFoundingYear">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ResearchGroup"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMemberCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ResearchGroup"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Agent">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ResearchOrganization">
  <rdfs:subClassOf rdf:resource="#Agent"/>
</owl:Class>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="#Agent"/>
</owl:Class>

<owl:Class rdf:about="#ResearchDomain">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#GrantAccreditation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ScientificOutput">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#HigherEducationInstitution">
  <rdfs:subClassOf rdf:resource="#ResearchOrganization"/>
</owl:Class>

<owl:Class rdf:about="#University">
  <rdfs:subClassOf rdf:resource="#HigherEducationInstitution"/>
</owl:Class>

<owl:Class rdf:about="#PublicUniversity">
  <rdfs:subClassOf rdf:resource="#University"/>
  <owl:disjointWith rdf:resource="#PrivateUniversity"/>
</owl:Class>

<owl:Class rdf:about="#PrivateUniversity">
  <rdfs:subClassOf rdf:resource="#University"/>
</owl:Class>

<owl:Class rdf:about="#ResearchInstitute">
  <rdfs:subClassOf rdf:resource="#ResearchOrganization"/>
</owl:Class>

<owl:Class rdf:about="#CERCAInstitute">
  <rdfs:subClassOf rdf:resource="#ResearchInstitute"/>
</owl:Class>

<owl:Class rdf:about="#BiomedicalResearchInstitute">
  <rdfs:subClassOf rdf:resource="#ResearchInstitute"/>
</owl:Class>

<owl:Class rdf:about="#JointResearchCenter">
  <rdfs:subClassOf rdf:resource="#ResearchInstitute"/>
</owl:Class>

<owl:Class rdf:about="#ResearchGroup">
  <rdfs:subClassOf rdf:resource="#ResearchOrganization"/>
</owl:Class>

<owl:Class rdf:about="#RecognizedResearchGroup">
  <rdfs:subClassOf rdf:resource="#ResearchGroup"/>
  <owl:disjointWith rdf:resource="#EmergingResearchGroup"/>
</owl:Class>

<owl:Class rdf:about="#EmergingResearchGroup">
  <rdfs:subClassOf rdf:resource="#ResearchGroup"/>
</owl:Class>

<owl:Class rdf:about="#Researcher">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#PrincipalInvestigator">
  <rdfs:subClassOf rdf:resource="#Researcher"/>
</owl:Class>

<owl:Class rdf:about="#SeniorResearcher">
  <rdfs:subClassOf rdf:resource="#Researcher"/>
</owl:Class>

<owl:Class rdf:about="#EarlyCareerResearcher">
  <rdfs:subClassOf rdf:resource="#Researcher"/>
</owl:Class>

<owl:Class rdf:about="#ExactAndNaturalSciences">
  <rdfs:subClassOf rdf:resource="#ResearchDomain"/>
</owl:Class>

<owl:Class rdf:about="#MedicalAndHealthSciences">
  <rdfs:subClassOf rdf:resource="#ResearchDomain"/>
</owl:Class>

<owl:Class rdf:about="#EngineeringAndTechnology">
  <rdfs:subClassOf rdf:resource="#ResearchDomain"/>
</owl:Class>

<owl:Class rdf:about="#SocialSciencesAndHumanities">
  <rdfs:subClassOf rdf:resource="#ResearchDomain"/>
</owl:Class>

<owl:Class rdf:about="#ComputerScienceDomain">
  <rdfs:subClassOf rdf:resource="#EngineeringAndTechnology"/>
</owl:Class>

<owl:Class rdf:about="#ArtificialIntelligenceDomain">
  <rdfs:subClassOf rdf:resource="#ComputerScienceDomain"/>
</owl:Class>

<owl:Class rdf:about="#KnowledgeRepresentationDomain">
  <rdfs:subClassOf rdf:resource="#ArtificialIntelligenceDomain"/>
</owl:Class>

<owl:Class rdf:about="#ComputerVisionDomain">
  <rdfs:subClassOf rdf:resource="#ArtificialIntelligenceDomain"/>
</owl:Class>

<owl:Class rdf:about="#NaturalLanguageProcessingDomain">
  <rdfs:subClassOf rdf:resource="#ArtificialIntelligenceDomain"/>
</owl:Class>

<owl:Class rdf:about="#SGRGrant">
  <rdfs:subClassOf rdf:resource="#GrantAccreditation"/>
</owl:Class>

<owl:Class rdf:about="#ConsolidatedSGRGrant">
  <rdfs:subClassOf rdf:resource="#SGRGrant"/>
  <owl:disjointWith rdf:resource="#EmergingSGRGrant"/>
</owl:Class>

<owl:Class rdf:about="#EmergingSGRGrant">
  <rdfs:subClassOf rdf:resource="#SGRGrant"/>
</owl:Class>

<owl:Class rdf:about="#PeerReviewedPublication">
  <rdfs:subClassOf rdf:resource="#ScientificOutput"/>
</owl:Class>

<owl:Class rdf:about="#DatasetOrArtifact">
  <rdfs:subClassOf rdf:resource="#ScientificOutput"/>
</owl:Class>

<owl:Class rdf:about="#AIResearchGroup">
  <rdfs:subClassOf rdf:resource="#ResearchGroup"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ResearchGroup"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#investigatesDomain"/>
          <owl:someValuesFrom rdf:resource="#ArtificialIntelligenceDomain"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#InterInstitutionalResearchGroup">
  <rdfs:subClassOf rdf:resource="#ResearchGroup"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ResearchGroup"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#belongsToInstitution"/>
          <owl:onClass rdf:resource="#ResearchOrganization"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ConsolidatedCatalanResearchGroup">
  <rdfs:subClassOf rdf:resource="#RecognizedResearchGroup"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#RecognizedResearchGroup"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#holdsGrant"/>
          <owl:someValuesFrom rdf:resource="#ConsolidatedSGRGrant"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#AcademicAILab">
  <rdfs:subClassOf rdf:resource="#AIResearchGroup"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#AIResearchGroup"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#belongsToInstitution"/>
          <owl:someValuesFrom rdf:resource="#University"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#ExactAndNaturalSciences"/>
    <rdf:Description rdf:about="#MedicalAndHealthSciences"/>
    <rdf:Description rdf:about="#EngineeringAndTechnology"/>
    <rdf:Description rdf:about="#SocialSciencesAndHumanities"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#ResearchOrganization"/>
    <rdf:Description rdf:about="#Person"/>
    <rdf:Description rdf:about="#ResearchDomain"/>
    <rdf:Description rdf:about="#GrantAccreditation"/>
    <rdf:Description rdf:about="#ScientificOutput"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
